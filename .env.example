# Mouton Chronicles - local settings for the build and run scripts.
# Copy this file to .env (ignored by git) and adjust the paths.
# Lines are KEY=VALUE; # starts a comment; values may be quoted.

# Open Watcom 2.0 root (contains binnt64\, h\, lib286\)
WATCOM=C:\WATCOM

# DOSBox-X executable (winget install joncampbell123.DOSBox-X)
DOSBOX=C:\DOSBox-X\dosbox-x.exe

# Optional: CD image (.cue) whose audio tracks 2-9 are the music, mounted as D:
# See docs/build-and-run.md, "Music".
CDIMAGE=

# Optional: extra arguments appended to the DOSBox-X command line
DOSBOX_ARGS=
