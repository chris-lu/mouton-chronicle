#include <stdio.h>
#include <conio.h>
#define NBF 14

char ListFich[20][13]={"Mouton.c","mouton.h","mouse.c","vga_c.c","variables.h","texte.c","textemen.c","palette.c","plans.c","moutgest.c","clavier.c","graph.c","option.c","start.c"};
unsigned long NbC=0;
unsigned short Lignes=0;

FILE *Fichier;


void main(void)
{
register cont;
char ch=0;
for (cont=0;cont<NBF;cont++)
{
if ((Fichier=fopen(ListFich[cont],"r"))!=NULL)
	{
	while((ch!=EOF))
		{
		ch=fgetc(Fichier);
		if(ch=='\n')
			Lignes++;
		NbC++;
		}
	ch=0;
	}
	else printf("\nFichier [%s] ignore....",ListFich[cont]);
}
printf("\n\nProjet : Mouton Chronicles");
printf("\nNombre de fichiers : %d",cont);
printf("\nNombre de characteres : %lu",NbC);
printf("\nNombre de lignes : %d",Lignes);
}

