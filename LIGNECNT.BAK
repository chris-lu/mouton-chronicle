#include <stdio.h>
#include <conio.h>
#define NBF 16

char ListFich[25][13]={"Mouton.c","mouton.h","mouse.c","vga_c.c","vga.c","variables.h","texte.c","palette.c","plans.c","moutgest.c","clavier.c","graph.c","option.c","start.c","cd.c","defil.c"};
unsigned long NbC=0;
unsigned char NbF=0;
unsigned char NbI=0;
unsigned short Lignes=0;

FILE *Fichier;


void main(void)
{
register cont;
char ch=0;
for (cont=0;cont<NBF;cont++)
{
if ((Fichier=fopen(ListFich[cont],"r"))!=NULL)
	{
	NbF++;
	while((ch!=EOF))
		{
		ch=fgetc(Fichier);
		if(ch=='\n')
			Lignes++;
		NbC++;
		}
	ch=0;
	fclose(Fichier);
	}
	else {printf("\nFichier [%s] ignore....",ListFich[cont]);NbI++;}
}
printf("\n\n*********************************************************");
printf("\n*****                 Statistiques                   ****");
printf("\n*********************************************************");
printf("\n\nProjet : Mouton Chronicles\n");
printf("\nNombre de fichiers lus : %d",NbF);
if(NbI)
printf("\n\tFichiers ignores : %d",NbI);
printf("\nNombre de characteres : %lu",NbC);
printf("\nNombre de lignes : %d",Lignes);
}

