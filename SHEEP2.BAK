#define ERROR	{ ModeTxt();	printf("error %X XMS",nb);	getch();	exit(0);	}
#define NBPLAN 4
#define TX 4*320
#include <conio.h>
#include <math.h>
#include <mouse.c>
#include <alloc.h>
#include <time.h>
#include "sheep.h"
#include "variable.c"
#include "Rtime.c"
#include "vga_c.c"
#include "vga.c"
