void Bal(void)                    //retour de balayage
{
asm{
mov dx,0x3DA;
wait1:
in al,dx;
test al,8;
jz wait1;
}
}


void ModeVGA(void)
{
  asm{
  push ds
  mov ax,13h
  int 10h
  pop ds}
  /*
  union REGS regs;

  regs.x.ax=0x0013;
  int86(0x10,&regs,&regs); */
}

void ModeTxt(void)
{
  asm{
  push ds
  mov ax,3
  int 10h
  pop ds
  }/*
  union REGS regs;

  regs.x.ax=0x0003;
  int86(0x10,&regs,&regs);   */
}



