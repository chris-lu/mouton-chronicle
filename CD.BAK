struct
{
char Copyright[38];
char First;
int Nombre;
}CD;

unsigned char Cur_Lect;

struct {
unsigned char Taille;
unsigned char SubUnit;
unsigned char Fonc;
unsigned short Status;
unsigned char rien[8];
unsigned char mediades;
void *buffer;
}Block1;

struct {
unsigned char Taille;
unsigned char SubUnit;
unsigned char Fonc;
unsigned short Status;
unsigned char rien[8];
unsigned char adrmode;
unsigned long deb;
unsigned long duree;
}Block2;


struct {
unsigned char sf;
unsigned char trac;
unsigned long deb;
unsigned char i;
}STrack;

struct {
unsigned long deb;
unsigned long taille;
}Tracks[25];

struct {
unsigned char sf;
unsigned char deb;
unsigned char fin;
unsigned long total;
}CDInf;


