void Message(char type,char modif,char Jou)
{
/*
Messages :
0 : manqué
1 : tué
2 : touché
3 : touché 2

*/
if(!Ecl)
{
type+=modif;
if(modif)
	Par[Cur_Par][0]=CURJ;
else
	Par[Cur_Par][0]=Jou;
Par[Cur_Par][1]=random(5)+5*type;
Par[Cur_Par++][2]=500;
if(Cur_Par>3)
	{
	Txt_Down();
	Cur_Par=3;
	}
}
}



void Test_Dom(unsigned char MaxDom)
{
register cont;
long temp,temp2,temp3;
unsigned short stat1,stat2;
unsigned long stat3,stat4;
unsigned char touch=0;
short dommages;
char rnd;
for(cont=0;cont<Options.Nb_J_Tot;cont++)
	{
	if(!Mouton[Liste[cont]].Mort)
		{
		temp=Mouton[Liste[cont]].PosX-Bombe.PosX+4;
		temp2=Mouton[Liste[cont]].PosY-Bombe.PosY+4;
		temp3=sqrt(temp2*temp2+temp*temp);
		if((temp<MaxDom&&temp>-MaxDom)&&(temp2<MaxDom&&temp2>-MaxDom))
			{
			rnd=random(4)&1;
			touch=1;
			dommages=MaxDom-temp3;
			if(dommages<1)
				dommages=1;
			Mouton[CURJ].Degats+=dommages;
			stat1=Mouton[CURJ].PosX-Bombe.PosX+4;
			stat2=Mouton[CURJ].PosY-Bombe.PosY+4;
			stat4=sqrt(stat2*stat2+stat1*stat1);
			stat3=(unsigned long)stat4*dommages/MaxDom;
			if (stat3>Stats.Precis)
				{
				Stats.Precis=stat3;
				Stats.Mouton[1]=CURJ;
				}
			if((Mouton[Liste[cont]].Pts_Vie-=dommages)<1)
				{
				if(Cur_Joueur!=cont)
					Mouton[CURJ].Frags++;
				else
					Mouton[CURJ].Frags--;
				Mouton[Liste[cont]].Mort=1;
				if(cont==Cur_Joueur)
					Message(11,0,Liste[cont]);
				else if(Mouton[Liste[cont]].Equipe==Mouton[CURJ].Equipe)
					Message(9,rnd,Liste[cont]);
				 else
					Message(7,rnd,Liste[cont]);
				Init_Explose(Mouton[Liste[cont]].PosX,Mouton[Liste[cont]].PosY+4,64);//creer l'explosion
				}
			else
				{
				if(cont==Cur_Joueur)
					Message(6,0,Liste[cont]);
				else if(Mouton[Liste[cont]].Equipe==Mouton[CURJ].Equipe)
					Message(4,rnd,Liste[cont]);
				else
					Message(2,rnd,Liste[cont]);
				}
			Mouton[Liste[cont]].Bouge++;
			if(temp)
				Mouton[Liste[cont]].DirX+=(dommages/12)*(temp/abs(temp));
			if(temp2)
				Mouton[Liste[cont]].DirY+=(dommages/5)*(temp2/abs(temp2));
			if(Mouton[Liste[cont]].DirX>5)
				Mouton[Liste[cont]].DirX=5;
				else 	if(Mouton[Liste[cont]].DirX<-5)
				Mouton[Liste[cont]].DirX=-5;
			if(Mouton[Liste[cont]].DirY>5)
				Mouton[Liste[cont]].DirY=5;
				else 	if(Mouton[Liste[cont]].DirY<-5)
				Mouton[Liste[cont]].DirY=-5;
			}
		}
	}
if(!touch&&Arme<2)
	{
	Message(0,0,CURJ);
	}

}






void Move_U(char nb)
{
register unsigned short cont=0;
Mouton[nb].Bloque=0;
if ((Plan_1[(Mouton[nb].PosX+4)/320][Y[201-Mouton[nb].PosY]+(int)(Mouton[nb].PosX+4)%320])&&(Mouton[nb].PosY<200))
	{
	while((Plan_1[(Mouton[nb].PosX+4)/320][Y[201-Mouton[nb].PosY-cont]+(int)(Mouton[nb].PosX+4)%320]))
		cont++;
	if (cont<4)
		{
		Mouton[nb].PosY+=cont;
		}
	else
		Mouton[nb].Bloque=1;
	}
}

void Put_Mouton(unsigned short x,char nb)
{
register unsigned char cont,temp;
Mouton[nb].PosX=x;
temp=x/320;
x%=320;
cont=1;
while(!(Plan_1[temp][Y[cont]+x+4]))
	cont++;
Mouton[nb].Bouge=0;
Mouton[nb].PosY=205-cont;
Mouton[nb].DirX=0;
Mouton[nb].DirY=0;

}


void Draw_Mouton(char nb)
{
register short cont;
short Xa,Ya;
/*for(cont=0;cont<8;cont++)
	Plan_1[Mouton[nb].PosX/320][Y[200-Mouton[nb].PosY-cont]+(int)Mouton[nb].PosX%320]=255;
  */
Xa=Mouton[nb].PosX;
Ya=Mouton[nb].PosY;
/*for(cont=0;cont<8;cont++)
	if((Xa>x)&&(Xa<(x+320))&&(Ya+cont>200-y)&&(Ya+cont<400-y))  //si dans l'écran...
		Page[(Y[400-y-Ya-cont]+(Xa-x))]=153;  //...afficher
 */
if((Mouton[nb].Bouge>6)||(nb!=CURJ))           //ENLEVER ||nb!=Liste[CURJ] et c'est tout rigolo!!!
	{
	if(Mouton[nb].DirY>1)
		Mouton[nb].Cur_Spr=2;
	else if (Mouton[nb].DirY>.3)
		Mouton[nb].Cur_Spr=1;
	else if (Mouton[nb].DirY>-.3)
		Mouton[nb].Cur_Spr=0;
	else if (Mouton[nb].DirY>-1)
		Mouton[nb].Cur_Spr=7;
	else
		Mouton[nb].Cur_Spr=6;
	}
	else if(Mouton[nb].Bouge)
	{
	Mouton[nb].Mouv++;
		Mouton[nb].Mouv&=15;
		Mouton[nb].Cur_Spr=Mouton[nb].Mouv>>1;
		}

if((Xa>x)&&(Xa<(x+312))&&(Ya>200-y)&&(Ya<392-y))  //si dans l'écran...
	{
	if(Mouton[nb].Sens==-1)
		Put(Xa-x,400-y-Ya-6,8,8,Page,Mout_Spr[0+Mouton[nb].Cur_Spr]);
	else
		Put(Xa-x,400-y-Ya-6,8,8,Page,Mout_Spr[8+Mouton[nb].Cur_Spr]);
	}
}



void Remove_Mouton(char nb)
{
register cont;
for(cont=0;cont<8;cont++)
	Plan_1[Mouton[nb].PosX/320][Y[200-Mouton[nb].PosY-cont]+(int)Mouton[nb].PosX%320]=0;
}


void Move_Mouton(char nb)
{
unsigned short Xa=Mouton[nb].PosX+4;
unsigned short Ya=Mouton[nb].PosY-1;

if (!(Plan_1[Xa/320][Y[200-Ya]+(Xa%320)])||(Mouton[nb].PosY-1>200))
	{
	//Mouton[nb].Can_Move=0;
	Mouton[nb].DirY-=Gravite;    //Attraction terrestre 9.81/2
	Add_Vent=Vent/4;         //Masse du mouton : 5
	if(!Mouton[nb].Bouge)
		{
		Mouton[nb].DirX=0.4*Mouton[nb].Sens+Add_Vent;
		Mouton[nb].Bouge++;
		}
	else
		{
		Mouton[nb].DirX+=Add_Vent;
		Mouton[nb].Bouge++;
		}
	}
else
	{
	if(Mouton[nb].DirY<-3)
		{
		if((Mouton[nb].Pts_Vie+=Mouton[nb].DirY)<1)
			{
			if(nb==CURJ)
				{
				Puissance=0;
				Tir=0;
				Wait=200;
				}
			Mouton[nb].Frags--;
			Mouton[nb].Mort=1;
			Init_Explose(Mouton[nb].PosX,Mouton[nb].PosY+4,64);//creer l'explosion
			Message(1,0,nb);
			}
		else
			{
			if(nb==CURJ)
				{
				Puissance=0;
				Tir=0;
				Wait=200;
				}
			Message(12,0,nb);
			}
		}
	if(!Mouton[nb].Bloque)
		{
		Add_Vent=0;
		Mouton[nb].Bouge=0;
		Mouton[nb].DirY=-Mouton[nb].DirY/4;
		Mouton[nb].DirX/=2;
		}
	}
Mouton[nb].PosY+=Mouton[nb].DirY;
Mouton[nb].PosX+=Mouton[nb].DirX;
Move_U(nb);
if (Mouton[nb].Bloque)
	{
	Mouton[nb].PosY=Ya+1;
	Mouton[nb].PosX=Xa-4-Mouton[nb].DirX*2;
	Mouton[nb].DirY=0;
	Mouton[nb].DirX=0;
	}
}

