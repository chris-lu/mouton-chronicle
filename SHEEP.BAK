#include <conio.h>
#include <math.h>
#include <mouse.c>
#include <alloc.h>
#include <time.h>
#include "variable.c"
#include "Rtime.c"
#include "vga_c.c"
#include "vga.c"
#include "plans.c"


unsigned short Y[960];
char A,B,C;

char explose=0;
float dirx=.19;
float diry=.55;
float posy=150;
float posx=100;




void Init_Ter(void)
{
register long cont;
unsigned short haut;
unsigned short temp;
unsigned char pos=100;
randomize();
A=random(2)+1;
B=random(11)+9;
C=random(12)+8;

for (cont=0;cont<960;cont++)
{
//Y[cont]=(sin(cont*0.001*A+1))*cos((cont)*0.0009*B+1)+cos((cont)*C*0.002)*0.1;
//Y[cont]=(random(5)-2)+((sin(cont*0.001*A+1))*cos((cont)*0.0009*B+1)+cos((cont)*C*0.002)*0.1);
//Y2[cont]=Y[cont];
//Y[cont]*=Y[cont];
/*Y[cont]*=89; */
Y[cont]=(random(5)-2)+((sin(cont*0.001*A+1))*cos((cont)*0.0009*B+1)+cos((cont)*C*0.002)*0.1);
if((pos+Y[cont]>25)&&(pos+Y[cont]<190))
pos+=Y[cont];

temp=(200-pos)*320+(cont%320);
Plan_1[cont/320][temp]=98;
Plan_1[cont/320][temp+320]=94;
Plan_1[cont/320][temp+640]=90;
Plan_1[cont/320][temp+960]=86;
Plan_1[cont/320][temp+1280]=90;
Plan_1[cont/320][temp+1600]=94;
for(haut=pos-6;haut>0;haut--)
  Plan_1[cont/320][(200-haut)*320+(cont%320)]=97;
}
}

void Memorise_Spr(void)
{
GetBlk2(320-28,0,28,28,Plan_2[1],Trou);
}

void Init_Bomb(void)
{
explose=0;
dirx=(float)(random(40)-20)/100;
diry=(float)(random(40)+10)/100;
posy=150;
posx=random(320)+320;
}


void Put_trou(short x,short y,word l,word h,bytef *buf)
{
  register byte j;
  register word i;
  for(j=0;j<h;j++)
  {
		for(i=0;i<l;i++)
	 {
		if(*buf==1)
			Plan_1[(x+i)/320][(y*320)+x+i]=0; //Transparence … l'encre 0
		buf++;
	 }
	 y++;
  }
}


void Move_Bomb(void)
{
if(!explose)
{
diry-=0.0019;
posy+=diry;
posx+=dirx;
}
if ((posy>0)&&(posy<200)&&(posx>0)&&(posx<960))
if(Plan_1[(int)posx/320][(((int)(200-posy)*320)+(int)posx)])
	{
	explose=1;
	Put_trou(posx-14,200-posy-14,28,28,Trou);
	}
}

void main(void)
{
unsigned long images=0;
unsigned short cont;
unsigned short x,y;
printf("Si ce progrmme fait planter windows(ce qui ne chagera pas vos habitudes)\nou redemarrer votre pc : vous n'avez pas assez de mememoire convetionnelle!");
getch();
for(cont=0;cont<3;cont++)
	if((Plan_1[cont]=(unsigned char far *)farmalloc(64000))==NULL)
	{
	printf("\npas assez de memoire conv.!");
	exit(1);
	}
for(cont=0;cont<2;cont++)
	if((Plan_2[cont]=(unsigned char far *)farmalloc(64000))==NULL)
	{
	printf("\npas assez de memoire conv.!");
	exit(1);
	}
/*if((Plan_3[0]=(unsigned char far *)farmalloc(64000))==NULL)
	{
	printf("\npas assez de memoire conv.!");
	exit(1);
	}*/
if((Page=(unsigned char far *)farmalloc(64000))==NULL)
	{
	printf("\npas assez de memoire conv.!");
	exit(1);
	}
Pal=(unsigned char far *)malloc(768);

for(cont=0;cont<3;cont++)
  Clr(Plan_1[cont]);
	//LoadPCX(fich[cont],Plan_1[cont],Pal);
for(cont=0;cont<2;cont++)
	LoadPCX(fich[cont+3],Plan_2[cont],Pal);
//	LoadPCX(fich[5],Plan_3[0],Pal);
Memorise_Spr();
Init_Ter();
ModeVGA();
getch();
SetAllPal(Pal);
InitMouse();
ZoneMouse(0,50,639,200);
DebTime();
//Put_trou(100,150,28,28,Plan_1[0],Trou);
while(!kbhit())
{
images++;
GetMouse(&x,&y);
//Cpy(Plan_3[0],Page);
Clr(Page);
CpyPlan(x>>2,(y>>1)+100,Plan_2,Page);
CpyPlan(x,y,Plan_1,Page);
Move_Bomb();
if(explose)
	Init_Bomb();
	else
if((posx>x)&&(posx<(x+320))&&(posy>200-y)&&(posy<400+y))
	Page[(((int)(200-posy)*320)+(int)(posx-x))]=80;
//Bal();
Draw(Page);
}
FinTime();
ModeTxt();
printf("\nTemps : %.3f sec.",temps);           //Affichage des performances
printf("\nImages : %d images",images);
printf("\nImages/Sec. : ");
textcolor(9);
cprintf("%.2f Images/Sec.",images/temps);
printf("\n");
printf("A:%d  B:%d  C:%d",A,B,C);
printf("free mem :%lu",coreleft());
}





